{
  "name": "astro-zen",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && pnpm run typecheck:api && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "optimize-images": "node scripts/optimize-images.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "lint": "eslint src/ --ext .ts,.tsx,.js,.astro",
    "lint:fix": "eslint src/ --ext .ts,.tsx,.js,.astro --fix",
    "prebuild": "node scripts/validate-build.js",
    "validate": "node scripts/validate-build.js"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.2",
    "@astrojs/tailwind": "^5.1.2",
    "@fontsource-variable/gabarito": "^5.1.0",
    "@fontsource/be-vietnam-pro": "^5.1.0",
    "astro": "^4.16.18",
    "resend": "^6.38.0",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-astro": "^1.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.5",
    "vite": "^8.0.0",
    "vitest": "^4.1.8"
  }
}
