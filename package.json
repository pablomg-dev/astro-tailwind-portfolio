{
  "name": "astro-zen",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && pnpm run typecheck:api && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "optimize-images": "node scripts/optimize-images.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "lint": "eslint src/ --ext .ts,.tsx,.js,.astro",
    "lint:fix": "eslint src/ --ext .ts,.tsx,.js,.astro --fix",
    "prebuild": "node scripts/validate-build.js",
    "validate": "node scripts/validate-build.js"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.6",
    "@astrojs/tailwind": "^5.1.5",
    "@fontsource-variable/gabarito": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "astro": "^4.16.19",
    "resend": "^6.40.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.4",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^8.57.1",
    "eslint-plugin-astro": "^1.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.5",
    "vite": "^8.4.0",
    "vitest": "^4.1.12"
  }
}
