---
import { ViewTransitions } from 'astro:transitions'
import Header from '@components/Header.astro'
import '@fontsource/be-vietnam-pro'
import '@fontsource-variable/gabarito'
import Footer from '@components/Footer.astro'
import ScrollToTop from '@components/ScrollToTop.astro'

import Background from '@components/Background.astro'
import { getTranslations } from '@config/translations'
import type { Locale } from '@types'

interface Props {
  title: string
  description: string
  navLinks: { text: string; href: string }[]
  author: string
  locale?: Locale
}

const { title, description, navLinks, author, locale = 'es' } = Astro.props
const t = getTranslations(locale)

const defaultSite = 'https://pablomgdev.xyz/'
const siteUrl = new URL(Astro.site || defaultSite).href
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href
const esUrl = new URL('/', siteUrl).href
const enUrl = new URL('/en/', siteUrl).href

const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author,
  url: 'https://pablomgdev.xyz',
  jobTitle: t.seo.jobTitle,
  knowsAbout: t.seo.knowsAbout,
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'AR',
  },
  sameAs: ['https://www.linkedin.com/in/pablomgdev/', 'https://github.com/pablomg-dev'],
})
---

<!doctype html>
<html lang={locale} class="scroll-smooth overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080812" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL('/vistaprevia.png', siteUrl)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL('/vistaprevia.png', siteUrl)} />

    <meta name="keywords" content={t.seo.keywords} />

    <meta property="og:locale" content={t.seo.ogLocale} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <script is:inline type="application/ld+json" set:html={personSchema} />

    <!-- Google Analytics (GA4) cargado después de la ruta crítica -->
    <script is:inline>
      const analyticsId = 'G-06GL1V332X'
      let analyticsLoaded = false

      function loadAnalytics() {
        if (analyticsLoaded) {
          return
        }

        analyticsLoaded = true
        window.dataLayer = window.dataLayer || []
        function gtag() {
          window.dataLayer.push(arguments)
        }

        window.gtag = gtag
        gtag('js', new Date())
        gtag('config', analyticsId)

        const script = document.createElement('script')
        script.async = true
        script.src = `https://www.googletagmanager.com/gtag/js?id=${analyticsId}`
        document.head.appendChild(script)
      }

      function scheduleAnalytics() {
        if (typeof window.requestIdleCallback === 'function') {
          window.requestIdleCallback(loadAnalytics, { timeout: 3000 })
        } else {
          window.setTimeout(loadAnalytics, 2000)
        }
      }

      if (document.readyState === 'complete') {
        scheduleAnalytics()
      } else {
        window.addEventListener('load', scheduleAnalytics, { once: true })
      }

      document.addEventListener('astro:page-load', () => {
        if (analyticsLoaded) {
          window.gtag('config', analyticsId, { page_path: window.location.pathname })
        }
      })
    </script>

    <ViewTransitions />
  </head>
  <body class="font-sans bg-space text-cream relative overflow-x-hidden">
    <Background />

    <Header {navLinks} {locale} />
    <main class="max-w-3xl px-5 mx-auto relative" transition:animate="none">
      <slot />
    </main>
    <Footer {author} />
    <ScrollToTop ariaLabel={t.scrollToTop.ariaLabel} />
    <script is:inline type="module">
      let observer = null

      function setupScrollAnimation() {
        try {
          const elements = document.querySelectorAll('[data-scroll-animation]:not([data-observed])')

          if (!observer) {
            observer = new IntersectionObserver(
              entries => {
                entries.forEach(entry => {
                  if (entry.isIntersecting) {
                    const target = entry.target
                    target.style.transform = 'translateY(0)'
                    target.style.opacity = '1'
                    observer?.unobserve(target)
                  }
                })
              },
              {
                threshold: 0.1,
                rootMargin: '50px',
              }
            )
          }

          elements.forEach(element => {
            element.dataset.observed = 'true'
            observer?.observe(element)
          })
        } catch (error) {
          console.error('Error en animación de scroll:', error)
        }
      }

      const setup = () => {
        try {
          setupScrollAnimation()
        } catch (error) {
          console.error('Error configurando animación de scroll:', error)
        }
      }

      document.addEventListener('astro:page-load', setup)
    </script>
  </body>
</html>
