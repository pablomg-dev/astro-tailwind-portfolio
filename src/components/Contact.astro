---
/**
 * Contact section with Resend-backed API submission
 */
interface Props {
  title: string
  subtitle: string
  nameLabel: string
  namePlaceholder?: string
  emailLabel: string
  emailPlaceholder?: string
  messageLabel: string
  messagePlaceholder?: string
  sendButton: string
  sendingButton?: string
  successMessage: string
  errorMessage?: string
  genericErrorMessage?: string
  honeypotLabel?: string
}

const {
  title,
  subtitle,
  nameLabel,
  namePlaceholder = 'Tu nombre',
  emailLabel,
  emailPlaceholder = 'tu@email.com',
  messageLabel,
  messagePlaceholder = '¿En qué puedo ayudarte?',
  sendButton,
  sendingButton = 'Enviando…',
  successMessage,
  errorMessage = 'Hubo un error al enviar el mensaje. Por favor, inténtalo de nuevo.',
  genericErrorMessage = 'No se pudo enviar el mensaje',
  honeypotLabel = 'Este campo no debe ser completado:',
} = Astro.props
---

<section class="py-20 relative" id="contact">
  <div class="absolute inset-0 bg-primary/5 blur-[80px] -z-10"></div>

  <div class="text-center mb-16">
    <h2
      class="text-4xl font-serif text-cream mb-4 tracking-widest uppercase opacity-0 translate-y-16 transition-all duration-1000"
      data-scroll-animation
    >
      {title}
    </h2>
    <p
      class="text-cream/60 font-light opacity-0 translate-y-16 transition-all duration-1000 delay-200"
      data-scroll-animation
    >
      {subtitle}
    </p>
  </div>

  <div
    class="max-w-xl mx-auto bg-midnight/40 backdrop-blur-xl border border-primary/10 p-8 rounded-3xl shadow-aura-lg opacity-0 translate-y-16 transition-all duration-1000 delay-300"
    data-scroll-animation
  >
    <form
      name="contact"
      method="POST"
      action="/api/contact"
      class="space-y-6"
      data-sending-text={sendingButton}
      data-generic-error={genericErrorMessage}
    >
      <p class="hidden">
        <label
          >{honeypotLabel}{' '}
          <input name="bot-field" tabindex="-1" autocomplete="off" /></label
        >
      </p>

      <div>
        <label for="name" class="block text-sm font-medium text-cream/80 mb-2 ml-1">
          {nameLabel}
        </label>
        <input
          type="text"
          name="name"
          id="name"
          required
          maxlength="100"
          autocomplete="name"
          class="w-full bg-space/50 border border-primary/10 rounded-2xl px-5 py-4 text-cream focus:ring-2 focus:ring-primary/20 focus:border-primary/30 outline-none transition-all duration-300"
          placeholder={namePlaceholder}
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-cream/80 mb-2 ml-1">
          {emailLabel}
        </label>
        <input
          type="email"
          name="email"
          id="email"
          required
          maxlength="254"
          autocomplete="email"
          class="w-full bg-space/50 border border-primary/10 rounded-2xl px-5 py-4 text-cream focus:ring-2 focus:ring-primary/20 focus:border-primary/30 outline-none transition-all duration-300"
          placeholder={emailPlaceholder}
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-cream/80 mb-2 ml-1">
          {messageLabel}
        </label>
        <textarea
          name="message"
          id="message"
          rows="5"
          required
          minlength="10"
          maxlength="5000"
          class="w-full bg-space/50 border border-primary/10 rounded-2xl px-5 py-4 text-cream focus:ring-2 focus:ring-primary/20 focus:border-primary/30 outline-none transition-all duration-300 resize-none"
          placeholder={messagePlaceholder}></textarea>
      </div>

      <button
        type="submit"
        id="submit-btn"
        class="w-full bg-primary/10 hover:bg-primary/20 border border-primary/20 text-primary font-serif text-lg py-4 rounded-2xl transition-all duration-500 hover:shadow-aura group flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <span id="btn-text">{sendButton}</span>
        <svg
          id="btn-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="group-hover:translate-x-1 transition-transform"
        >
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>

    <div
      id="form-success"
      class="hidden mt-6 p-6 bg-primary/10 border border-primary/20 rounded-2xl text-primary text-center font-light animate-in fade-in zoom-in duration-500 hover:outline-none"
      role="status"
      aria-live="polite"
      tabindex="-1"
    >
      <div class="flex flex-col items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-primary/20 flex items-center justify-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <p class="text-lg">{successMessage}</p>
      </div>
    </div>

    <div
      id="form-error"
      class="hidden mt-6 p-6 bg-red-500/10 border border-red-500/20 rounded-2xl text-red-400 text-center font-light animate-in fade-in zoom-in duration-500 hover:outline-none"
      role="alert"
      aria-live="assertive"
      tabindex="-1"
    >
      <div class="flex flex-col items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-red-500/20 flex items-center justify-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-red-400"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </div>
        <p class="text-lg" id="form-error-text">
          {errorMessage}
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  function initContact() {
    const form = document.querySelector('form[name="contact"]') as HTMLFormElement
    const successMsg = document.getElementById('form-success')
    const errorMsg = document.getElementById('form-error')
    const errorText = document.getElementById('form-error-text')
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement
    const btnText = document.getElementById('btn-text')
    const btnIcon = document.getElementById('btn-icon')

    if (form && successMsg && errorMsg && submitBtn && btnText) {
      if (form.dataset.bound === 'true') {
        return
      }
      form.dataset.bound = 'true'

      const originalBtnText = btnText.textContent
      const sendingText = form.dataset.sendingText || 'Enviando…'
      const genericError = form.dataset.genericError || 'No se pudo enviar el mensaje'
      let isSubmitting = false

      form.addEventListener('submit', async e => {
        e.preventDefault()

        if (isSubmitting || submitBtn.disabled) {
          return
        }

        isSubmitting = true
        submitBtn.disabled = true
        btnText.textContent = sendingText
        if (btnIcon) {
          btnIcon.classList.add('hidden')
        }
        errorMsg.classList.add('hidden')

        const formData = new FormData(form)
        const body = new URLSearchParams()
        for (const [key, value] of formData.entries()) {
          if (typeof value === 'string') {
            body.append(key, value)
          }
        }

        try {
          const response = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString(),
          })

          let payload: { ok?: boolean; error?: string } = {}
          try {
            payload = (await response.json()) as { ok?: boolean; error?: string }
          } catch {
            payload = {}
          }

          if (response.ok && payload.ok !== false) {
            form.classList.add('hidden')
            successMsg.classList.remove('hidden')
            successMsg.focus()
            successMsg.scrollIntoView({ behavior: 'smooth', block: 'center' })
            return
          }

          throw new Error(payload.error || genericError)
        } catch (error) {
          console.error('Error al enviar formulario:', error)

          isSubmitting = false
          submitBtn.disabled = false
          btnText.textContent = originalBtnText
          if (btnIcon) {
            btnIcon.classList.remove('hidden')
          }

          if (errorText && error instanceof Error && error.message) {
            errorText.textContent = error.message
          }

          errorMsg.classList.remove('hidden')
          errorMsg.focus()
          errorMsg.scrollIntoView({ behavior: 'smooth', block: 'center' })
        }
      })
    }
  }

  document.addEventListener('astro:page-load', initContact)
</script>
