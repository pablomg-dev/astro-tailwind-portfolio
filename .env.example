# Resend — required for /api/contact (server-only, never expose to the client)
# Create a dedicated API key for this portfolio only (e.g. name: "astro-tailwind-portfolio").
# Do not reuse keys from other projects. Do not commit the real value.
RESEND_API_KEY=

# Inbox that receives contact form messages (existing public contact email).
CONTACT_TO_EMAIL=pablomg.developer@gmail.com

# Verified Resend sender (requires pablomgdev.xyz verified in Resend).
# Pending DNS verification before production use:
CONTACT_FROM_EMAIL=Pablo MG Dev <contacto@pablomgdev.xyz>
